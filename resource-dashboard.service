[Unit]
Description=Resource & GPU Utilization Dashboard (Flask)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=joshua
WorkingDirectory=/home/joshua/resource_dashboard
ExecStart=/home/joshua/resource_dashboard/.venv/bin/python /home/joshua/resource_dashboard/app.py --host 0.0.0.0 --port 5000
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=FLASK_ENV=production

[Install]
WantedBy=multi-user.target
