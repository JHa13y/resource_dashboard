[Unit]
Description=Resource & GPU Utilization Dashboard (Flask)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=joshua
WorkingDirectory=/home/joshua/resource_dashboard
# Replace LLAMA_HOST / VLLM_HOST with the hostname/IP of the machine(s)
# running the LLM server(s). In auto mode (default) the dashboard probes
# vLLM first, then llama.cpp; pin with --llm-backend {llama|vllm}.
# Drop both URL flags if the Local LLM section is not needed.
# T9: `python -m app` runs the explicit bootstrap (main()), which resolves
# the settings (CLI > config > defaults) and starts the collector on the
# resolved settings. A WSGI server (e.g. `waitress-serve app:wsgi`, T10)
# uses the `wsgi` entry point, which applies the config's settings at
# import time so it no longer runs on built-in defaults.
ExecStart=/home/joshua/resource_dashboard/.venv/bin/python -m app --config /home/joshua/resource_dashboard/config.yaml
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=FLASK_ENV=production

[Install]
WantedBy=multi-user.target
